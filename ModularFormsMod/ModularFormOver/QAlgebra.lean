import ModularFormsMod.ModularFormOver.GradedRing

/-!
# The algebra of Fourier expansions across weights

`fourierAlgHom` sums the Fourier expansions of a graded modular form, and
`qAlgebra R Γ` is its image in `R⟦X⟧`. At level one, when `6` is invertible,
this image is generated by the Fourier expansions of `E₄` and `E₆`.
-/

open DirectSum PowerSeries MatrixGroups

variable {R : Type} [CommRing R] [Algebra R ℂ] [FaithfulSMul R ℂ]
  {Γ : Subgroup (GL (Fin 2) ℝ)} [Γ.IsArithmetic] [Γ.HasDetOne] {k : ℤ}


namespace ModularFormOver

/-- The algebra homomorphism obtained by summing Fourier expansions across weights. -/
noncomputable def fourierAlgHom :
    (⨁ k : ℤ, ModularFormOver R Γ k) →ₐ[R] R⟦X⟧ :=
  DirectSum.toAlgebra R (ModularFormOver R Γ) (fun _ => fourierLinearMap)
    (by
      change fourier R (1 : ModularFormOver R Γ 0) = 1
      exact fourier_one R R)
    (fun f g => fourier_mul R R f g)

/-- On a homogeneous summand, the graded Fourier homomorphism is the usual Fourier expansion. -/
@[simp] theorem fourierAlgHom_of (f : ModularFormOver R Γ k) :
    fourierAlgHom (DirectSum.of (ModularFormOver R Γ) k f) = fourier R f := by
  simp [fourierAlgHom, DirectSum.toAlgebra, DirectSum.toSemiring]

variable (R) (Γ) in
/-- The subalgebra of `R⟦X⟧` consisting of finite sums of Fourier expansions across weights. -/
noncomputable def qAlgebra : Subalgebra R R⟦X⟧ :=
  fourierAlgHom (Γ := Γ).range

variable (R) in
/-- Evaluate the two polynomial variables at the Fourier expansions of `E₄` and `E₆`. -/
noncomputable def eisensteinFourierEval : MvPolynomial (Fin 2) R →ₐ[R] R⟦X⟧ :=
  MvPolynomial.aeval ![fourier R (E₄.tower R), fourier R (E₆.tower R)]

/-- The first variable evaluates to the Fourier expansion of `E₄`. -/
@[simp] theorem eisensteinFourierEval_X_zero :
    eisensteinFourierEval R (MvPolynomial.X 0) = fourier R (E₄.tower R) := by
  simp [eisensteinFourierEval]

/-- The second variable evaluates to the Fourier expansion of `E₆`. -/
@[simp] theorem eisensteinFourierEval_X_one :
    eisensteinFourierEval R (MvPolynomial.X 1) = fourier R (E₆.tower R) := by
  simp [eisensteinFourierEval]

/-- Taking Fourier expansions commutes with polynomial evaluation at `E₄` and `E₆`. -/
theorem fourierAlgHom_comp_eisensteinEval :
    (fourierAlgHom (R := R) (Γ := 𝒮ℒ)).comp (eisensteinEval R) =
      eisensteinFourierEval R := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;> simp

/-- Evaluating a form's polynomial representation at the Eisenstein Fourier expansions recovers
its Fourier expansion. -/
@[simp] theorem eisensteinFourierEval_toPolynomial [Invertible (6 : R)]
    (f : ModularFormOver R 𝒮ℒ k) :
    eisensteinFourierEval R f.toPolynomial = fourier R f := by
  rw [← fourierAlgHom_comp_eisensteinEval, AlgHom.comp_apply,
    eisensteinEval_toPolynomial, fourierAlgHom_of]

/-- Over a ring in which `6` is invertible, the level-one Fourier algebra is the
range of polynomial evaluation at the Fourier expansions of `E₄` and `E₆`. -/
theorem qAlgebra_eq [Invertible (6 : R)] :
    qAlgebra R 𝒮ℒ = (eisensteinFourierEval R).range := by
  rw [qAlgebra, ← fourierAlgHom_comp_eisensteinEval]
  ext q
  simp only [AlgHom.mem_range, AlgHom.comp_apply]
  constructor
  · rintro ⟨f, rfl⟩
    obtain ⟨p, rfl⟩ := eisensteinEval_surjective R f
    exact ⟨p, rfl⟩
  · rintro ⟨p, rfl⟩
    exact ⟨eisensteinEval R p, rfl⟩

end ModularFormOver

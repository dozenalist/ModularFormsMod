import ModularFormsMod.ModularFormOver.QAlgebra
import ModularFormsMod.ModularFormMod.Defs
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The graded algebra and Fourier algebra of reduced modular forms

Reduction induces a surjective homomorphism of graded algebras. After summing
Fourier expansions across weights, `rAlgebra r Γ` is the coefficientwise image
of `qAlgebra R Γ`. For surjective `r`, it is also the quotient by the ideal of
expansions whose coefficients reduce to zero. At level one with `6` invertible,
it is generated by the reduced expansions of `E₄` and `E₆`.
-/

open ModularFormOver PowerSeries MatrixGroups DirectSum

namespace PowerSeries

variable {R S : Type*} [CommRing R] [CommRing S]

/-- Coefficientwise reduction of a power-series subalgebra along a surjective ring map.
Surjectivity ensures that the image contains all constants over the target ring. -/
noncomputable def mapSubalgebra (r : R →+* S) [RingHomSurjective r]
    (A : Subalgebra R R⟦X⟧) :
    Subalgebra S S⟦X⟧ :=
  { A.toSubsemiring.map (PowerSeries.map r) with
    algebraMap_mem' := by
      intro s
      obtain ⟨a, rfl⟩ := r.surjective s
      exact ⟨algebraMap R R⟦X⟧ a, A.algebraMap_mem a, by simp⟩ }

/-- A series lies in the mapped subalgebra precisely when it is the coefficientwise image of a
member of the original subalgebra. -/
@[simp] theorem mem_mapSubalgebra (r : R →+* S) [RingHomSurjective r]
    (A : Subalgebra R R⟦X⟧) {f : S⟦X⟧} :
    f ∈ mapSubalgebra r A ↔ ∃ g ∈ A, PowerSeries.map r g = f := Iff.rfl

/-- The underlying set of the mapped subalgebra is the coefficientwise image of the original
underlying set. -/
@[simp] theorem coe_mapSubalgebra (r : R →+* S) [RingHomSurjective r]
    (A : Subalgebra R R⟦X⟧) :
    (mapSubalgebra r A : Set S⟦X⟧) = PowerSeries.map r '' (A : Set R⟦X⟧) := rfl

end PowerSeries

variable {R S : Type} [CommRing R] [Algebra R ℂ] [FaithfulSMul R ℂ] [CommRing S]
  {Γ : Subgroup (GL (Fin 2) ℝ)} [Γ.IsArithmetic] [Γ.HasDetOne] {k : ℤ}

namespace ModularFormMod

/-- Source-ring scalars give the weight-indexed reduced forms a graded algebra structure. -/
noncomputable instance instGAlgebra (r : R →+* S) :
    DirectSum.GAlgebra R (ModularFormMod r Γ) where
  toFun :=
    { toFun := fun a => a • (1 : ModularFormMod r Γ 0)
      map_zero' := zero_smul R _
      map_add' := fun a b => add_smul a b _ }
  map_one := one_smul R _
  map_mul a b := by
    apply gradedMonoid_eq_of_cast (by rfl)
    apply ModularFormMod.ext
    change ((a * b) • (1 : ModularFormMod r Γ 0)).fourier =
      ((a • (1 : ModularFormMod r Γ 0)).mul (b • 1)).fourier
    simp [PowerSeries.smul_eq_C_mul]
  commutes a x := by
    obtain ⟨k, f⟩ := x
    apply gradedMonoid_eq_of_cast ((zero_add k).trans (add_zero k).symm)
    apply ModularFormMod.ext
    change ((a • (1 : ModularFormMod r Γ 0)).mul f).fourier =
      (f.mul (a • (1 : ModularFormMod r Γ 0))).fourier
    simp [PowerSeries.smul_eq_C_mul, mul_comm]
  smul_def a x := by
    obtain ⟨k, f⟩ := x
    apply gradedMonoid_eq_of_cast (zero_add k).symm
    apply ModularFormMod.ext
    change (a • f).fourier = ((a • (1 : ModularFormMod r Γ 0)).mul f).fourier
    simp [PowerSeries.smul_eq_C_mul]

end ModularFormMod

namespace ModularFormOver

/-- Reduction of modular forms, preserving their weights in the graded algebra. -/
noncomputable def ReduceAlgHom (r : R →+* S) :
    (⨁ k : ℤ, ModularFormOver R Γ k) →ₐ[R] ⨁ k : ℤ, ModularFormMod r Γ k :=
  DirectSum.toAlgebra R (ModularFormOver R Γ)
    (fun k => (DirectSum.lof R ℤ (ModularFormMod r Γ) k).comp (ReduceLinearMap (r := r)))
    (by
      change DirectSum.of (ModularFormMod r Γ) 0
        (Reduce r (1 : ModularFormOver R Γ 0)) = 1
      rw [Reduce_one]
      rfl)
    (fun f g => by
      change DirectSum.of (ModularFormMod r Γ) _ (Reduce r (f.mul g)) =
        DirectSum.of (ModularFormMod r Γ) _ (Reduce r f) *
          DirectSum.of (ModularFormMod r Γ) _ (Reduce r g)
      rw [Reduce_mul, DirectSum.of_mul_of]
      rfl)

/-- Graded reduction restricts on each weight summand to coefficientwise reduction of forms. -/
@[simp] theorem ReduceAlgHom_of (r : R →+* S) (f : ModularFormOver R Γ k) :
    ReduceAlgHom r (DirectSum.of (ModularFormOver R Γ) k f) =
      DirectSum.of (ModularFormMod r Γ) k (Reduce r f) := by
  simp [ReduceAlgHom, DirectSum.toAlgebra, DirectSum.toSemiring, DirectSum.lof_eq_of]

/-- Every graded reduced form lifts to a graded form over the original ring. -/
theorem ReduceAlgHom_surjective (r : R →+* S) :
    Function.Surjective (ReduceAlgHom r (Γ := Γ)) := by
  intro f
  induction f using DirectSum.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | of k f =>
    obtain ⟨g, hg⟩ := f.modular
    refine ⟨DirectSum.of (ModularFormOver R Γ) k g, ?_⟩
    rw [ReduceAlgHom_of]
    congr 1
    exact ModularFormMod.ext hg.symm
  | add f g hf hg =>
    obtain ⟨f, rfl⟩ := hf
    obtain ⟨g, rfl⟩ := hg
    exact ⟨f + g, map_add _ _ _⟩

end ModularFormOver

namespace ModularFormMod

/-- The graded algebra of reduced forms over the target coefficient ring. -/
noncomputable instance (priority := 900) instGAlgebraOfSurjective (r : R →+* S)
    [RingHomSurjective r] : DirectSum.GAlgebra S (ModularFormMod r Γ) where
  toFun :=
    { toFun := const
      map_zero' := ModularFormMod.ext (by simp)
      map_add' := fun a b => ModularFormMod.ext (by simp) }
  map_one := ModularFormMod.ext (by simp)
  map_mul a b := by
    apply gradedMonoid_eq_of_cast (by rfl)
    apply ModularFormMod.ext
    change C (a * b) = C a * C b
    exact map_mul C a b
  commutes a x := by
    obtain ⟨k, f⟩ := x
    apply gradedMonoid_eq_of_cast ((zero_add k).trans (add_zero k).symm)
    apply ModularFormMod.ext
    change C a * f.fourier = f.fourier * C a
    exact mul_comm _ _
  smul_def a x := by
    obtain ⟨k, f⟩ := x
    apply gradedMonoid_eq_of_cast (zero_add k).symm
    apply ModularFormMod.ext
    change (a • f).fourier = C a * f.fourier
    simp [PowerSeries.smul_eq_C_mul]

/-- The algebra homomorphism obtained by summing reduced Fourier expansions across weights. -/
noncomputable def fourierAlgHom (r : R →+* S) [RingHomSurjective r] :
    (⨁ k : ℤ, ModularFormMod r Γ k) →ₐ[S] S⟦X⟧ :=
  DirectSum.toAlgebra S (ModularFormMod r Γ) (fun _ => fourierLinearMap)
    (by
      change (1 : ModularFormMod r Γ 0).fourier = 1
      rfl)
    (fun _ _ => rfl)

/-- The graded Fourier homomorphism restricts to the Fourier expansion on each weight summand. -/
@[simp] theorem fourierAlgHom_of (r : R →+* S) [RingHomSurjective r]
    (f : ModularFormMod r Γ k) :
    fourierAlgHom r (DirectSum.of (ModularFormMod r Γ) k f) = f.fourier := by
  simp [fourierAlgHom, DirectSum.toAlgebra, DirectSum.toSemiring]

/-- The algebra of Fourier expansions of reduced modular forms across all weights. -/
noncomputable def rAlgebra (r : R →+* S) [RingHomSurjective r]
  (Γ : Subgroup (GL (Fin 2) ℝ)) [Γ.IsArithmetic] [Γ.HasDetOne] :
    Subalgebra S S⟦X⟧ := (fourierAlgHom r (Γ := Γ)).range

/-- Summing Fourier expansions after graded reduction equals coefficientwise reduction of the
original sum. -/
@[simp] theorem fourierAlgHom_ReduceAlgHom (r : R →+* S) [RingHomSurjective r]
    (f : ⨁ k : ℤ, ModularFormOver R Γ k) :
    fourierAlgHom r (ReduceAlgHom r f) =
      PowerSeries.map r (ModularFormOver.fourierAlgHom f) := by
  induction f using DirectSum.induction_on with
  | zero => simp
  | of k f => simp
  | add f g hf hg => simp [hf, hg]

/-- The reduced Fourier algebra is the coefficientwise image of the Fourier algebra over `R`. -/
theorem rAlgebra_eq_map (r : R →+* S) [RingHomSurjective r] :
    rAlgebra r Γ = PowerSeries.mapSubalgebra r (qAlgebra R Γ) := by
  ext q
  change (∃ f, fourierAlgHom r f = q) ↔
    ∃ g, g ∈ qAlgebra R Γ ∧ PowerSeries.map r g = q
  constructor
  · rintro ⟨f, rfl⟩
    obtain ⟨g, rfl⟩ := ReduceAlgHom_surjective r f
    exact ⟨ModularFormOver.fourierAlgHom g, ⟨g, rfl⟩,
      (fourierAlgHom_ReduceAlgHom r g).symm⟩
  · rintro ⟨g, hg, rfl⟩
    obtain ⟨f, rfl⟩ := (AlgHom.mem_range _).mp hg
    exact ⟨ReduceAlgHom r f, fourierAlgHom_ReduceAlgHom r f⟩

/-- The underlying set of the reduced Fourier algebra is the coefficientwise image
of the Fourier algebra over `R`. -/
theorem coe_rAlgebra_eq_map (r : R →+* S) [RingHomSurjective r] :
    (rAlgebra r Γ : Set S⟦X⟧) =
      PowerSeries.map r '' (qAlgebra R Γ : Set R⟦X⟧) := by
  rw [rAlgebra_eq_map, PowerSeries.coe_mapSubalgebra]

/-- Equivalently, the reduced Fourier algebra is the range of coefficient reduction
restricted to the Fourier algebra over `R`. -/
theorem rAlgebra_eq_range (r : R →+* S) [RingHomSurjective r] :
    (rAlgebra r Γ : Set S⟦X⟧) =
      Set.range (fun f : qAlgebra R Γ => PowerSeries.map r (f : R⟦X⟧)) := by
  rw [coe_rAlgebra_eq_map, Set.image_eq_range]
  rfl

/-- Evaluate the two polynomial variables at the reduced Fourier expansions of `E₄` and `E₆`. -/
noncomputable def eisensteinFourierEval (r : R →+* S) :
    MvPolynomial (Fin 2) S →ₐ[S] S⟦X⟧ :=
  MvPolynomial.aeval ![(Reduce r (E₄.tower R)).fourier, (Reduce r (E₆.tower R)).fourier]

/-- The first variable evaluates to the reduced Fourier expansion of `E₄`. -/
@[simp] theorem eisensteinFourierEval_X_zero (r : R →+* S) :
    eisensteinFourierEval r (MvPolynomial.X 0) = (Reduce r (E₄.tower R)).fourier := by
  simp [eisensteinFourierEval]

/-- The second variable evaluates to the reduced Fourier expansion of `E₆`. -/
@[simp] theorem eisensteinFourierEval_X_one (r : R →+* S) :
    eisensteinFourierEval r (MvPolynomial.X 1) = (Reduce r (E₆.tower R)).fourier := by
  simp [eisensteinFourierEval]

/-- Polynomial evaluation at `E₄` and `E₆` commutes with coefficient reduction. -/
@[simp] theorem eisensteinFourierEval_map (r : R →+* S) (p : MvPolynomial (Fin 2) R) :
    eisensteinFourierEval r (MvPolynomial.map r p) =
      PowerSeries.map r (ModularFormOver.eisensteinFourierEval R p) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [eisensteinFourierEval, ModularFormOver.eisensteinFourierEval]
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp =>
    fin_cases i <;> simp [hp]

/-- Over a ring in which `6` is invertible, the level-one reduced Fourier algebra is
the range of polynomial evaluation over `S` at the reduced expansions of `E₄` and `E₆`. -/
theorem rAlgebra_eq (r : R →+* S) [RingHomSurjective r] [Invertible (6 : R)] :
    rAlgebra r 𝒮ℒ = (eisensteinFourierEval r).range := by
  ext q
  change (∃ f, fourierAlgHom r f = q) ↔ ∃ p, eisensteinFourierEval r p = q
  constructor
  · rintro ⟨f, rfl⟩
    obtain ⟨g, rfl⟩ := ReduceAlgHom_surjective r f
    have hg : ModularFormOver.fourierAlgHom g ∈ qAlgebra R 𝒮ℒ := ⟨g, rfl⟩
    rw [qAlgebra_eq] at hg
    obtain ⟨p, hp⟩ := (AlgHom.mem_range _).mp hg
    refine ⟨MvPolynomial.map r p, ?_⟩
    rw [eisensteinFourierEval_map, hp, fourierAlgHom_ReduceAlgHom]
  · rintro ⟨p, rfl⟩
    obtain ⟨p, rfl⟩ := MvPolynomial.map_surjective r r.surjective p
    have hp : ModularFormOver.eisensteinFourierEval R p ∈ qAlgebra R 𝒮ℒ := by
      rw [qAlgebra_eq]
      exact ⟨p, rfl⟩
    obtain ⟨f, hf⟩ := (AlgHom.mem_range _).mp hp
    refine ⟨ReduceAlgHom r f, ?_⟩
    rw [fourierAlgHom_ReduceAlgHom, hf, eisensteinFourierEval_map]

/-- Coefficient reduction restricted to the Fourier algebra over `R`, with codomain
the reduced Fourier algebra. -/
noncomputable def qAlgebraReduce (r : R →+* S) [RingHomSurjective r] :
    qAlgebra R Γ →+* rAlgebra r Γ :=
  (PowerSeries.map r).restrict (qAlgebra R Γ) (rAlgebra r Γ) (by
    intro f hf
    rw [rAlgebra_eq_map]
    exact ⟨f, hf, rfl⟩)

/-- The underlying power series of a reduced Fourier-algebra element is its coefficientwise
reduction. -/
@[simp] theorem coe_qAlgebraReduce (r : R →+* S) [RingHomSurjective r]
    (f : qAlgebra R Γ) :
    (qAlgebraReduce r f : S⟦X⟧) = PowerSeries.map r (f : R⟦X⟧) := rfl

/-- Every element of the reduced Fourier algebra lifts to the Fourier algebra over `R`. -/
theorem qAlgebraReduce_surjective (r : R →+* S) [RingHomSurjective r] :
    Function.Surjective (qAlgebraReduce r (Γ := Γ)) := by
  intro f
  have hf := (coe_rAlgebra_eq_map r (Γ := Γ)).subset f.property
  obtain ⟨g, hg, hgf⟩ := hf
  exact ⟨⟨g, hg⟩, Subtype.ext hgf⟩

/-- The ideal of Fourier expansions over `R` whose coefficients vanish under reduction. -/
noncomputable def reductionKernel (r : R →+* S) [RingHomSurjective r] :
    Ideal (qAlgebra R Γ) :=
  RingHom.ker (qAlgebraReduce r (Γ := Γ))

/-- An expansion belongs to the reduction kernel exactly when its coefficientwise reduction is
zero. -/
@[simp] theorem mem_reductionKernel (r : R →+* S) [RingHomSurjective r]
    (f : qAlgebra R Γ) :
    f ∈ reductionKernel r ↔ PowerSeries.map r (f : R⟦X⟧) = 0 := by
  rw [reductionKernel, RingHom.mem_ker]
  exact Subtype.ext_iff

/-- The reduced Fourier algebra is the Fourier algebra over `R` modulo the
coefficient-reduction kernel. -/
noncomputable def rAlgebraEquivQuotient (r : R →+* S) [RingHomSurjective r] :
    rAlgebra r Γ ≃+* (qAlgebra R Γ) ⧸ reductionKernel r (Γ := Γ) :=
  (RingHom.quotientKerEquivOfSurjective (qAlgebraReduce_surjective r (Γ := Γ))).symm

/-- The quotient presentation sends a reduced expansion to the class of any chosen lift. -/
@[simp] theorem rAlgebraEquivQuotient_qAlgebraReduce (r : R →+* S) [RingHomSurjective r]
    (f : qAlgebra R Γ) :
    rAlgebraEquivQuotient r (qAlgebraReduce r f) =
      Ideal.Quotient.mk (reductionKernel r (Γ := Γ)) f :=
  RingHom.quotientKerEquivOfSurjective_symm_apply (qAlgebraReduce_surjective r) f

/-- The inverse quotient presentation sends the class of an expansion to its reduction. -/
@[simp] theorem rAlgebraEquivQuotient_symm_mk (r : R →+* S) [RingHomSurjective r]
    (f : qAlgebra R Γ) :
    (rAlgebraEquivQuotient r).symm (Ideal.Quotient.mk (reductionKernel r (Γ := Γ)) f) =
      qAlgebraReduce r f := rfl

end ModularFormMod
